# ---- Culto Kids | CBVIDA RIO ----
# Copie para .env (desenvolvimento) ou cadastre como variáveis/segredos do servidor.

# Senha do painel /admin (obrigatória para liberar o painel)
ADMIN_PASSWORD=
# Opcional: segredo para assinar a sessão do admin (se vazio, deriva da senha)
ADMIN_SESSION_SECRET=

# Banco de dados de produção (Supabase). Sem estas duas, o sistema usa um
# arquivo JSON local (.data/culto-kids.json) — serve só para desenvolvimento.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: endereço público do site, para a imagem de preview no WhatsApp
# ser uma URL absoluta. Ex.: https://seusite.com.br
VITE_SITE_URL=
